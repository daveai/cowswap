      "@cowprotocol/sdk-subgraph": "https://npm.pkg.github.com/download/@cowprotocol/sdk-subgraph/1.2.1-pr-972-4dd606f5.0/e4fd5773e201cd2159108ba3c13642f852c1a42a",
      "@cowprotocol/sdk-trading": "https://npm.pkg.github.com/download/@cowprotocol/sdk-trading/2.2.6-pr-972-4dd606f5.0/a0ada181988b7fdcac5b94505b37e2d231d7fe1c",
      "@cowprotocol/sdk-viem-adapter": "https://npm.pkg.github.com/download/@cowprotocol/sdk-viem-adapter/0.3.26-pr-972-4dd606f5.0/d722c6feb6c20aba30dc399f3104b3d08ba8578d",
      "@cowprotocol/sdk-weiroll": "https://npm.pkg.github.com/download/@cowprotocol/sdk-weiroll/0.2.2-pr-972-4dd606f5.0/8fec39cf0c30abb5ac341dd537d26a9b6e2ea568"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "graphql": "16",
        "cross-fetch": "4",
        "@walletconnect/ethereum-provider": "2.23"
      },
      "ignoreMissing": [
